FROM oven/bun:1.1.45 AS deps
WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates tar python3 make g++ && \
    rm -rf /var/lib/apt/lists/*

COPY package.json bun.lockb* ./
RUN bun install --ignore-scripts

FROM oven/bun:1.1.45 AS builder
WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates tar python3 make g++ && \
    rm -rf /var/lib/apt/lists/*

ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_PRIVATE_BUILD_WORKER=1
ENV NODE_OPTIONS=--max-old-space-size=2048

COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN POSTGRES_SSL=false \
    POSTGRES_URL=postgres://postgres:postgres@postgres:5432/verceldb \
    POSTGRES_WS_PROXY=pg_proxy:80/v1 \
    LOCAL_AUTH_USER_ID=local-admin \
    LOCAL_AUTH_USER_NAME="Local Admin" \
    LOCAL_AUTH_PASSWORD=local-build-password \
    NEXT_PUBLIC_LOCAL_AUTH_USER_ID=local-admin \
    SPACES_ENDPOINT=http://minio:9000 \
    SPACES_PUBLIC_ENDPOINT=http://localhost:9000 \
    SPACES_ENDPOINT_CDN=http://localhost:9000 \
    SPACES_REGION=nyc3 \
    SPACES_BUCKET=comfyui-deploy \
    SPACES_KEY=comfydeploy \
    SPACES_SECRET=local-build-secret \
    SPACES_CDN_DONT_INCLUDE_BUCKET=false \
    SPACES_CDN_FORCE_PATH_STYLE=true \
    MODAL_BUILDER_URL= \
    JWT_SECRET=local-build-jwt-secret \
    PLAUSIBLE_DOMAIN= \
    NEXT_PUBLIC_POSTHOG_KEY= \
    NEXT_PUBLIC_POSTHOG_HOST= \
    bun run build

FROM oven/bun:1.1.45 AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/public ./public
COPY --from=builder /app/src ./src
COPY --from=builder /app/drizzle ./drizzle
COPY --from=builder /app/migrate.mts ./migrate.mts
COPY --from=builder /app/next.config.mjs ./next.config.mjs

EXPOSE 3000
CMD ["bun", "run", "start", "--hostname", "0.0.0.0"]

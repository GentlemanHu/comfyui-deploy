JWT_SECRET=replace-with-openssl-rand-hex-32
LOCAL_AUTH_USER_ID=local-admin
LOCAL_AUTH_USER_NAME=Local Admin
LOCAL_AUTH_PASSWORD=
COMFYDEPLOY_WEB_IMAGE=ghcr.io/gentlemanhu/comfyui-deploy-web:latest
COMFYDEPLOY_GO_IMAGE=comfydeploy-go:local
COMFYDEPLOY_WEB_MODE=prod
NODE_OPTIONS=--max-old-space-size=1024
NEXT_PRIVATE_BUILD_WORKER=1

SPACES_ENDPOINT=http://minio:9000
SPACES_PUBLIC_ENDPOINT=http://localhost:9000
SPACES_ENDPOINT_CDN=http://localhost:9000
SPACES_REGION=nyc3
SPACES_BUCKET=comfyui-deploy
SPACES_KEY=comfydeploy
SPACES_SECRET=replace-with-a-strong-minio-password
SPACES_CDN_DONT_INCLUDE_BUCKET=false
SPACES_CDN_FORCE_PATH_STYLE=true
MINIO_API_CORS_ALLOW_ORIGIN=*
MINIO_SCANNER_SPEED=slowest

# Baota/Nginx reverse proxy example:
# SPACES_PUBLIC_ENDPOINT=https://s3.example.com
# SPACES_ENDPOINT_CDN=https://s3.example.com
